  "empty_empty_iou": 1.0,
  "filtered_component_counts_must_match": true,
  "rules": "Every image and class must pass. Relative error is diagnostic near zero; acceptance uses abs(gpu-cpu) <= atol + rtol*abs(cpu). Do not revise thresholds after observing results."
